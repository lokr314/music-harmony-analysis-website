---
import Layout from "../../layouts/Layout.astro";
import type { Modulation } from "../../data/modulations";
import { getModulationEntries } from "../../data/modulations";
import { getMediaAssets, type MediaAssets } from "../../data/media";

export const prerender = true;

interface PageProps {
	id: string;
	modulation: Modulation;
	media: MediaAssets;
}

export function getStaticPaths() {
	return getModulationEntries().map(([id, modulation]) => ({
		params: { id },
		props: {
			id,
			modulation,
			media: getMediaAssets(id),
		},
	}));
}

const { id, modulation, media } = Astro.props as PageProps;
const hasExample = id === "28";
---

<Layout title={`Modulation ${id} • Tonal Modulations`}>
	<main class="mx-auto flex max-w-4xl flex-col gap-10 px-6 py-16 text-stone-900">
		<nav>
			<a class="text-sm font-medium text-sky-700 hover:underline" href="/modulations">← Back to all modulations</a>
		</nav>

		<header class="space-y-3">
			<p class="text-sm uppercase tracking-wide text-stone-500">Modulation</p>
			<h1 class="text-3xl font-semibold tracking-tight">Entry {id}</h1>
			<p class="text-base text-stone-600">
				Consult the harmonic blueprint for modulation {id}, including intervallic distance, pitch-class content, and hierarchical
				relationships. Supplement the analysis with commentary and supporting media for rehearsal or presentation purposes.
			</p>
			{hasExample ? (
				<div class="inline-flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm font-medium text-green-800">
					<span class="h-2 w-2 rounded-full bg-green-500"></span>
					This modulation ships with an example performance in the media library below.
				</div>
			) : null}
		</header>

		<section class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
			<h2 class="text-xl font-semibold text-stone-900">Core Data</h2>
			<div class="mt-4 grid gap-6 sm:grid-cols-2">
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Start Keyset</h3>
					<ul class="mt-2 space-y-1 text-sm text-stone-700">
						{modulation.start_keyset.map(([pitchClass, type]) => (
							<li>{pitchClass} {type}</li>
						))}
					</ul>
				</div>
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">End Keyset</h3>
					<ul class="mt-2 space-y-1 text-sm text-stone-700">
						{modulation.end_keyset.map(([pitchClass, type]) => (
							<li>{pitchClass} {type}</li>
						))}
					</ul>
				</div>
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Pitch-Class Set</h3>
					<p class="mt-2 text-sm text-stone-700">{modulation.pcset.join(", ") || "—"}</p>
				</div>
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Distance</h3>
					<p class="mt-2 text-sm text-stone-700">{modulation.distance}</p>
				</div>
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Key-defining chord</h3>
					<p class="mt-2 text-sm text-stone-700">{modulation.unambiguous_pcset ? "Yes" : "No"}</p>
				</div>
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Base Modulation</h3>
					<p class="mt-2 text-sm text-stone-700">
						{modulation.base_modulation ? `Yes (No. ${modulation.base_modulation_number ?? "n/a"})` : "No"}
					</p>
				</div>
			</div>
		</section>

		<section class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
			<h2 class="text-xl font-semibold text-stone-900">Relationships</h2>
			<div class="mt-4 space-y-4 text-sm text-stone-700">
				{modulation.containing.length ? (
					<div>
						<p class="font-medium text-stone-800">Containing</p>
						<ul class="ml-4 mt-2 list-disc space-y-1">
							{modulation.containing.map((value) => (
								<li>
									<a class="text-sky-700 hover:underline" href={`/modulations/${value}`}>{value}</a>
								</li>
							))}
						</ul>
					</div>
				) : null}
				{modulation.transitive_containing.length ? (
					<div>
						<p class="font-medium text-stone-800">Transitive Containing</p>
						<ul class="ml-4 mt-2 list-disc space-y-1">
							{modulation.transitive_containing.map((value) => (
								<li>
									<a class="text-sky-700 hover:underline" href={`/modulations/${value}`}>{value}</a>
								</li>
							))}
						</ul>
					</div>
				) : null}
				{modulation.children.length ? (
					<div>
						<p class="font-medium text-stone-800">Children</p>
						<ul class="ml-4 mt-2 list-disc space-y-1">
							{modulation.children.map((value) => (
								<li>
									<a class="text-sky-700 hover:underline" href={`/modulations/${value}`}>{value}</a>
								</li>
							))}
						</ul>
					</div>
				) : null}
				{!modulation.containing.length && !modulation.transitive_containing.length && !modulation.children.length ? (
					<p class="text-sm text-stone-600">No additional relationships recorded for this modulation.</p>
				) : null}
			</div>
		</section>

		<section class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
			<h2 class="text-xl font-semibold text-stone-900">Additional Notes</h2>
			<p class="mt-3 text-sm text-stone-600">
				Record analytical observations, rehearsal instructions, or contextual references associated with this modulation.
			</p>
			<textarea
				class="mt-4 w-full rounded-lg border border-stone-300 bg-stone-50 p-4 text-sm text-stone-800 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200"
				rows={8}
				placeholder="Capture session notes, structural cues, or interpretative guidance..."
			></textarea>
		</section>

		<section class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
			<h2 class="text-xl font-semibold text-stone-900">Media Library</h2>
			<p class="mt-3 text-sm text-stone-600">
				Add rehearsal recordings or score walkthroughs to <code class="rounded bg-stone-100 px-1 py-0.5 text-xs text-stone-700">public/media/modulations/{id}</code>.
				Supported audio formats: mp3, wav, ogg, m4a, flac, aac. Supported video formats: mp4, webm, ogg, mov, m4v.
			</p>

			<div class="mt-6 space-y-6">
				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Audio</h3>
					{media.audio.length ? (
						<ul class="mt-3 space-y-4">
							{media.audio.map((src) => (
								<li class="space-y-2 rounded-lg border border-stone-200 p-4">
									<p class="text-sm font-medium text-stone-700">{src.split("/").pop()}</p>
									<audio class="w-full" controls src={src}>
										Your browser does not support the audio element.
									</audio>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-3 text-sm text-stone-600">No audio files found. Add files to display them here.</p>
					)}
				</div>

				<div>
					<h3 class="text-sm font-medium uppercase tracking-wide text-stone-500">Video</h3>
					{media.video.length ? (
						<ul class="mt-3 space-y-4">
							{media.video.map((src) => (
								<li class="space-y-2 rounded-lg border border-stone-200 p-4">
									<p class="text-sm font-medium text-stone-700">{src.split("/").pop()}</p>
									<video class="w-full rounded-lg" controls src={src}>
										Your browser does not support the video element.
									</video>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-3 text-sm text-stone-600">No video files found. Add files to display them here.</p>
					)}
				</div>
			</div>
		</section>
	</main>
</Layout>

