<Layout title="Impressum">
	<main class="mx-auto flex max-w-4xl flex-col gap-8 px-6 py-16 text-stone-900">
		<header class="space-y-3">
			<h1 class="text-3xl font-semibold tracking-tight">Impressum</h1>
