					<p>
						<strong>Name:</strong><br />
						Louis Krüger
					</p>
					<p>
						<strong>Adresse:</strong><br />
						Bremer Weg 29 <br />
						27211 Bassum
					</p>
					<p>
						<strong>E-Mail:</strong><br />
						<a href="mailto:louiskrueger2002@gmail.com" class="text-sky-700 hover:underline">louiskrueger2002@gmail.com</a>
					</p>
					<p>
