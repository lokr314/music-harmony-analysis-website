					<a href="tel:+4915201408625" class="text-sky-700 hover:underline">+49 1520 1408625</a>
				</p>
			</div>

			<div class="rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
				<h2 class="text-xl font-semibold text-stone-900 mb-4">Haftungsausschluss</h2>
				<div class="space-y-4 text-sm text-stone-700">
					<div>
						<h3 class="font-semibold text-stone-900 mb-2">Haftung für Links</h3>
						<p>
